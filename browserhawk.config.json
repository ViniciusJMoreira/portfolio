{
  "target": "http://localhost:3000",
  "auth": {
    "type": "none",
    "steps": [],
    "successIndicator": { "type": "url", "value": "localhost" }
  },
  "entryPoint": "/",
  "discovery": {
    "maxDepth": 3,
    "maxPages": 30,
    "excludePatterns": [],
    "sameDomainOnly": true
  },
  "bugReporting": {
    "target": "conversation"
  },
  "knownRoutes": [
    { "path": "/", "name": "Home" },
    { "path": "/about", "name": "About" },
    { "path": "/projects", "name": "Projects" },
    { "path": "/blog", "name": "Blog" },
    { "path": "/blog/articolo-di-prova", "name": "Articolo di prova" }
  ],
  "healthCheck": {
    "command": "curl -s http://localhost:3000 -o /dev/null -w '%{http_code}'",
    "expectedOutput": "200",
    "startCommand": "npm run dev"
  }
}
